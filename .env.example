DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one test server.
DISCORD_GUILD_ID=
# Production: set DATABASE_URL to your managed PostgreSQL connection string.
# Local development: leave DATABASE_URL empty to use SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Set true on the always-on production worker to prevent accidental SQLite fallback.
REQUIRE_POSTGRES=false
DATABASE_PATH=./data/rank-rascal.db
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Trusted reverse proxies in front of the worker (used for per-client rate limits). Railway edge = 1.
# Set 0 to ignore X-Forwarded-For (local dev).
TRUSTED_PROXY_HOPS=1
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
APP_SECRET=
ADMIN_DISCORD_IDS=

# Game website community inbox. Create a private, moderator-only Discord
# channel webhook and keep the URL server-side. Never prefix it NEXT_PUBLIC_.
COMMUNITY_INBOX_WEBHOOK_URL=
# Random secret used only to hash rate-limit fingerprints in memory.
COMMUNITY_RATE_SALT=

# Transactional email for community receipts, QA badges and certificates.
# Verify rankrascal.lol with your email provider before using this sender.
RESEND_API_KEY=
COMMUNITY_OWNER_EMAIL=
COMMUNITY_FROM_EMAIL=Rascal Realms <community@rankrascal.lol>
# Random secret used to create stable, non-guessable submission IDs.
COMMUNITY_ID_SALT=
# Full setup and go-live checklist: docs/rascal-realms/COMMUNITY_SETUP.md

# Ask Razz AI answers (server-side only). Without a key Razz uses scripted answers.
# Set a monthly spend limit in the Anthropic Console. See docs/rascal-realms/ASK_RAZZ.md.
ANTHROPIC_API_KEY=
RAZZ_MODEL=
RAZZ_DAILY_LIMIT=500

# Public website settings used by the Next.js site.
NEXT_PUBLIC_SITE_URL=https://rankrascal.lol
# Optional public invite to the moderated Rank Rascal community server.
NEXT_PUBLIC_COMMUNITY_URL=https://discord.gg/gkneGrpzAn
