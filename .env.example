DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in one test server.
DISCORD_GUILD_ID=
# Production: set DATABASE_URL to your managed PostgreSQL connection string.
# Local development: leave DATABASE_URL empty to use SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Set true on the always-on production worker to prevent accidental SQLite fallback.
REQUIRE_POSTGRES=false
DATABASE_PATH=./data/rank-rascal.db
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
APP_SECRET=
ADMIN_DISCORD_IDS=
