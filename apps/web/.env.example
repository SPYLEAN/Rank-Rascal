# Rank Rascal Web Application Environment Template
# Do NOT place real secrets in NEXT_PUBLIC_ variables.

# Production domain URL (e.g., https://rankrascal.com)
NEXT_PUBLIC_SITE_URL=https://rankrascal.com

# Discord Bot OAuth Install URL
NEXT_PUBLIC_DISCORD_INSTALL_URL=https://discord.com/oauth2/authorize?client_id=YOUR_DISCORD_CLIENT_ID&scope=bot%20applications.commands&permissions=117760

# Support & Legal Contact Email (Required in production)
NEXT_PUBLIC_SUPPORT_EMAIL=support@rankrascal.com

# Linked Roles Feature Flag (Keep false until Discord Role Connections OAuth is configured)
NEXT_PUBLIC_LINKED_ROLES_ENABLED=false

# Shared Production PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@host:5432/rank_rascal_db
