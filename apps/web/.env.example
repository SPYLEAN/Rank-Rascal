# Rank Rascal Web Application Environment Template
# Do NOT place real secrets in NEXT_PUBLIC_ variables. Everything prefixed
# NEXT_PUBLIC_ is embedded in the client bundle and visible to every visitor.

# Production site origin
NEXT_PUBLIC_SITE_URL=https://rankrascal.lol

# Installation gate. Keep false until the launch gate passes (worker, OAuth,
# install URL, legal pages, private-guild test). While false, /invite and
# /api/invite never redirect to Discord and every install button says Coming Soon.
NEXT_PUBLIC_INVITE_ENABLED=false

# Discord bot install link. Only used when NEXT_PUBLIC_INVITE_ENABLED=true.
# Minimal permissions: View Channels, Send Messages, Embed Links, Attach Files,
# Read Message History (117760). Leave blank until launch.
NEXT_PUBLIC_DISCORD_INSTALL_URL=

# Support and legal contact email. Leave blank until the mailbox is configured
# and monitored; the site then shows "Mailbox opening soon" instead of a link.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Linked Roles feature flag (keep false until Discord Role Connections OAuth is configured)
NEXT_PUBLIC_LINKED_ROLES_ENABLED=false

# Official Discord community server
NEXT_PUBLIC_COMMUNITY_URL=https://discord.gg/gkneGrpzAn
